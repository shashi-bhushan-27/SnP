# Copy to .env (git-ignored). Every value below is optional; the defaults run offline with no downloads.

# --- storage -----------------------------------------------------------------
# Default is SQLite at data/prism.db. PostgreSQL example (docker-compose.yml provides this database):
# DATABASE_URL=postgresql+psycopg2://prism:prism@localhost:5432/prism

# --- NLP backends --------------------------------------------------------------
# lexicon = instant baseline | finbert = ProsusAI/finbert (needs requirements-ml.txt, ~440 MB download)
SENTIMENT_BACKEND=lexicon
# rules = regex rules | embedding = nearest prototype | hybrid = both (needs requirements-ml.txt, ~130 MB)
EVENT_BACKEND=rules
# dictionary = curated company list | spacy = dictionary + spaCy ORG entities (pip install spacy + en_core_web_sm)
ENTITY_BACKEND=dictionary
# FINBERT_MODEL=ProsusAI/finbert
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- sources -------------------------------------------------------------------
# comma separated: replay,gdelt,newsapi
ENABLED_SOURCES=replay
# NewsAPI free plan: 100 requests/day, 24 h delay, development use only. Keep the key server-side.
NEWSAPI_KEY=
NEWSAPI_DAILY_BUDGET=80
# REPLAY_FILE=data/replay/sample_news.jsonl
REPLAY_BATCH_SIZE=3

# --- live polling --------------------------------------------------------------
SCHEDULER_ENABLED=false
GDELT_POLL_SECONDS=300
NEWSAPI_POLL_SECONDS=1200
REPLAY_POLL_SECONDS=5

# --- downstream / API ------------------------------------------------------------
STRESS_AUTO_TRIGGER=true
WRITE_SIGNALS_JSONL=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501
